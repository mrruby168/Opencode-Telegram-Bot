# Copy sang .env va dien that - KHONG commit .env
TELEGRAM_BOT_TOKEN=put-your-token-here
TELEGRAM_ALLOWED_USERS=1784770769
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PROJECT_DIR=D:\AI-AGENT
# Ten lenh opencode (Windows .cmd duoc xu ly an toan, khong noi chuoi tu input)
OPENCODE_BIN=opencode
# Auth server opencode: VUA la pass client VUA la pass khi bot tu spawn server
# (serve doc OPENCODE_SERVER_PASSWORD tu env — da do thuc te).
# Lay tu cau hinh bridge hien tai, KHONG de secret vao code
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Timeout tong cho 1 task opencode (ms), tam dung khi cho duyet permission
TASK_TIMEOUT_MS=1800000
# Het han duyet permission (ms)
PERMISSION_TTL_MS=300000
# Tran cho duyet permission/question (ms): qua lau -> tu dung an toan
PERMISSION_WAIT_MAX_MS=900000
# Thu muc task MMO (mac dinh <OPENCODE_PROJECT_DIR>\MMO\Mmo)
# MMO_DIR=
# Timeout 1 luot task MMO: code 60p, task khac 30p (ms). task/bot.json de duoc tung task
MMO_CODE_TIMEOUT_MS=3600000
MMO_TASK_TIMEOUT_MS=1800000
# Idle qua lau khong tien trien (ms) -> TIMEOUT de bam Tiep tuc
MMO_IDLE_TIMEOUT_MS=600000
# Model opencode (tuy chon, ca hai phai co hoac ca hai de trong).
# Neu server khong co model mac dinh mà .env cũng không đặt, task báo lỗi rõ thay vì treo.
# OPENCODE_MODEL_PROVIDER=
# OPENCODE_MODEL_ID=
